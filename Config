
/* =========================================================
   SLT App - Install + Notifications Access Sheets

   1. Install / Home Screen instructions
   2. Web Push notification permission
   3. PartnerGuestPush subscription integration
   4. Backend subscription synchronization
   5. Save guest access preferences through saveAccess()

   Uses the SAME push integration as AllowAccess.js.

   Testing:
   Add ?access=1 to a home page URL when CONFIG.testMode = true.
   ========================================================= */

let accessInstallPrompt = null;
let accessInstalled = isInstalledApp();
let accessManualShown = false;

let accessFinishing = false;
let accessSyncing = false;
let accessInstallBusy = false;

/* =========================================================
   PWA INSTALL EVENTS
   ========================================================= */

window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    accessInstallPrompt = e;
});

window.addEventListener('appinstalled', () => {
    accessInstalled = true;
});

/* =========================================================
   INITIALIZATION
   ========================================================= */

document.addEventListener('DOMContentLoaded', () => {

    if (!getSession()) return;

    const replay =
        CONFIG.testMode &&
        new URLSearchParams(location.search).get('access') === '1';

    if (readStorage(STORAGE.accessDone) && !replay) {
        return;
    }

    buildSheets();

    setTimeout(() => {

        accessInstalled = isInstalledApp();

        if (accessInstalled) {
            openNotifySheet();
        } else {
            openInstallSheet();
        }

    }, 700);
});

/* =========================================================
   BUILD ACCESS SHEETS
   ========================================================= */

function buildSheets() {

    if (document.getElementById('accessBackdrop')) return;

    const iphone = isIphoneOrIpad();

    document.body.insertAdjacentHTML('beforeend', `

        <div class="access-backdrop" id="accessBackdrop"></div>

        <!-- INSTALL SHEET -->

        <section
