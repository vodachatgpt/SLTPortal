/* =========================================================
   SLT App - Install + notifications pop-ups

   Shown once over the home page (Home, Day0, EventDay, LastDay):

     1) How to make app shortcut
     2) Keep Notifications On!

   Push integration:
     ../js/guest-push.js

   Uses the same PartnerGuestPush implementation
   as AllowAccess.js.

   Testing:
     Add ?access=1 when CONFIG.testMode = true.
   ========================================================= */


/* ================= STATE ================= */

let accessInstallPrompt = null;
let accessInstalled = isInstalledApp();
let accessManualShown = false;

let accessNotifyBusy = false;
let accessFinishing = false;


/* ================= PWA INSTALL EVENTS ================= */

window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    accessInstallPrompt = e;
});

window.addEventListener('appinstalled', () => {
    accessInstalled = true;
});


/* ================= INIT ================= */

document.addEventListener('DOMContentLoaded', () => {

    const replay =
        CONFIG.testMode &&
        new URLSearchParams(location.search).get('access') === '1';

    if (!getSession()) return;

    if (readStorage(STORAGE.accessDone) && !replay) return;

    buildSheets();

    setTimeout(() => {

        if (accessInstalled) {
            openNotifySheet();
        } else {
            openInstallSheet();
        }

    }, 700);

});


/* ================= MARKUP ================= */

function buildSheets() {

    const iphone = isIphoneOrIpad();

    document.body.insertAdjacentHTML('beforeend', `

        <div class="access-backdrop" id="accessBackdrop"></div>

        <!-- 1) INSTALL -->

        <section
            class="access-sheet"
            id="installSheet"
            role="dialog"
            aria-modal="true"
            aria-labelledby="installTitle"
            aria-hidden="true">

            <div class="access-top">

                <button
                    type="button"
                    class="access-close"
                    id="installClose"
                    aria-label="Close">

                    ${ACCESS_ICONS.close}

                </button>

            </div>

            <div class="access-body">

                <img
                    src="../media/assets/VFLogo3D.png"
                    class="access-img"
                    alt="">

                <h2 class="access-title" id="installTitle">
                    How to make app shortcut
                </h2>

                <p class="access-text">
                    Follow these simple steps to get ready for your visit
                </p>

                <ul class="access-steps">

                    <li>
                        ${ACCESS_ICONS.install}
                        <span>
                            <b>Install the App</b>
                            Once installed, add the app to your home screen
                        </span>
                    </li>

                    <li>
                        ${ACCESS_ICONS.shortcut}
                        <span>
                            <b>App Shortcut</b>
                            Select Add Shortcut or Add to Home Screen.
                        </span>
                    </li>

                    <li>
                        ${ACCESS_ICONS.bell}
                        <span>
                            <b>Allow Notifications</b>
                            Never miss an update during your stay
                        </span>
                    </li>

                </ul>

                <p class="access-note ${iphone ? '' : 'd-none'}"
                   id="iphoneNote">

                    ${ACCESS_ICONS.share}

                    <span>
                        On iPhone: tap <b>Share</b> in Safari,
                        then <b>Add to Home Screen</b>.
                        You’ll sign in once more from the app.
                    </span>

                </p>

                <p class="access-note d-none" id="androidNote">

                    ${ACCESS_ICONS.menu}

                    <span>
                        Open the browser menu <b>⋮</b>,
                        then tap <b>Add to Home screen</b>
                        or <b>Install app</b>.
                    </span>

                </p>

                <button
                    type="button"
                    class="btn-vf access-btn"
                    id="installBtn">

                    Install

                </button>

            </div>

        </section>


        <!-- 2) NOTIFICATIONS -->

        <section
            class="access-sheet notify-sheet"
            id="notifySheet"
            role="dialog"
            aria-modal="true"
            aria-labelledby="notifyTitle"
            aria-hidden="true">

            <div class="access-top">

                <button
                    type="button"
                    class="access-close"
                    id="notifyClose"
                    aria-label="Close">

                    ${ACCESS_ICONS.close}

                </button>

            </div>

            <div class="access-body">

                <img
                    src="../media/assets/Bell3D.png"
                    class="access-img bell-img"
                    alt="">

                <h2 class="access-title bold" id="notifyTitle">
                    Keep Notifications On!
                </h2>

                <p class="access-text">
                    Stay updated on what matters during your stay.
                </p>

                <button
                    type="button"
                    class="btn-vf access-btn"
                    id="notifyBtn">

                    <span class="btn-label">
                        Allow Notification
                    </span>

                    <span
                        class="spinner-border spinner-border-sm d-none"
                        aria-hidden="true">
                    </span>

                </button>

                <button
                    type="button"
                    class="btn-vf-light access-btn access-btn-light"
                    id="notifySkipBtn">

                    Not now

                </button>

            </div>

        </section>

    `);


    /* ================= INSTALL EVENTS ================= */

    document
        .getElementById('installBtn')
        .addEventListener('click', onInstallTap);

    document
        .getElementById('installClose')
        .addEventListener('click', afterInstallSheet);


    /* =====================================================
       NOTIFICATION BUTTON

       Same push SDK and enable method as AllowAccess.js.
       ===================================================== */

    document
        .getElementById('notifyBtn')
        .addEventListener('click', onNotifyAllowTap);


    document
        .getElementById('notifySkipBtn')
        .addEventListener('click', () => {
            finishAccess('skipped');
        });


    document
        .getElementById('notifyClose')
        .addEventListener('click', () => {
            finishAccess('skipped');
        });

}


/* ================= 1) INSTALL ================= */

function openInstallSheet() {

    document.body.classList.add('access-open');

    showSheet('installSheet');

}


async function onInstallTap() {

    if (accessManualShown) {

        afterInstallSheet();

        return;
    }

    if (accessInstallPrompt) {

        try {

            const prompt = accessInstallPrompt;

            accessInstallPrompt = null;

            await prompt.prompt();

            const choice = await prompt.userChoice;

            if (choice && choice.outcome === 'accepted') {
                accessInstalled = true;
            }

        } catch (err) {

            console.warn('[SLT Install]', err);

        }

        afterInstallSheet();

        return;
    }

    const note = document.getElementById(
        isIphoneOrIpad() ? 'iphoneNote' : 'androidNote'
    );

    note.classList.remove('d-none');
    note.classList.remove('flash');

    void note.offsetWidth;

    note.classList.add('flash');

    document.getElementById('installBtn').textContent = 'Done';

    accessManualShown = true;

}


function afterInstallSheet() {

    if (
        'Notification' in window &&
        (
            Notification.permission === 'default' ||
            CONFIG.testMode
        )
    ) {

        openNotifySheet();

    } else {

        finishAccess(currentNotifyPermission());

    }

}


/* ================= 2) NOTIFICATIONS ================= */

function openNotifySheet() {

    document.body.classList.add('access-open');

    const install = document.getElementById('installSheet');

    if (install && install.classList.contains('open')) {
        install.classList.add('behind');
    }

    showSheet('notifySheet');

}


/* =====================================================
   PUSH SDK ACCESS

   IMPORTANT:
   Use window.PartnerGuestPush explicitly.

   This avoids relying on the bare global identifier.
   ===================================================== */

function getPartnerGuestPush() {

    const push = window.PartnerGuestPush;

    if (!push) {

        console.error(
            '[SLT Access Sheets] PartnerGuestPush is missing.',
            {
                currentPage: window.location.href,
                pushScriptLoaded: Array.from(document.scripts)
                    .some(script =>
                        script.src.includes('/js/guest-push.js')
                    ),
                availablePushGlobal: Object.keys(window)
                    .filter(key => key.toLowerCase().includes('push'))
            }
        );

        throw new Error(
            'Guest Push SDK is not available. Check that guest-push.js loaded successfully.'
        );

    }

    if (typeof push.enable !== 'function') {

        throw new Error(
            'Guest Push SDK loaded, but its enable() method is unavailable.'
        );

    }

    return push;

}


/* ================= ALLOW NOTIFICATION ================= */

async function onNotifyAllowTap() {

    if (accessNotifyBusy || accessFinishing) return;

    accessNotifyBusy = true;

    setAccessLoading(true);

    clearPushError();

    try {

        /*
           iPhone requires the installed Home Screen application.
        */

        if (isIphoneOrIpad() && !isInstalledApp()) {

            throw new Error(
                'Install and open the Home Screen app on iPhone first.'
            );

        }


        /*
           Retrieve the actual SDK global.
        */

        const push = getPartnerGuestPush();


        /*
           Use the same method as AllowAccess.js.
        */

        const result = await push.enable();


        /*
           Require a confirmed subscription.
           Browser permission alone is not enough.
        */

        if (!result || result.subscribed !== true) {

            throw new Error(
                'Subscription was not confirmed by SLTAPI.'
            );

        }


        console.log(
            '[SLT Access Sheets] Push subscription confirmed.',
            result
        );


        await finishAccess('granted');

    } catch (err) {

        console.error(
            '[SLT Access Sheets] Notification enable failed:',
            err
        );

        showPushError(
            'Notifications were not enabled: ' +
            (err && err.message
                ? err.message
                : 'Unknown error') +
            '. Retry or select Not now.'
        );

    } finally {

        accessNotifyBusy = false;

        if (!accessFinishing) {
            setAccessLoading(false);
        }

    }

}


/* ================= UNUSED LEGACY HANDLER ================= */

async function onAllowTap() {

    setAccessLoading(true);

    try {

        const permission = await Notification.requestPermission();

        await finishAccess(permission);

    } catch (err) {

        console.warn('[SLT Notification Permission]', err);

    } finally {

        if (!accessFinishing) {
            setAccessLoading(false);
        }

    }

}


/* ================= PERMISSION ================= */

function currentNotifyPermission() {

    return 'Notification' in window
        ? Notification.permission
        : 'unsupported';

}


/* ================= FINISH ================= */

async function finishAccess(notifications) {

    if (accessFinishing) return;

    accessFinishing = true;

    writeStorage(STORAGE.accessDone, 'yes');

    closeAllSheets();

    try {

        await saveAccess(
            accessInstalled,
            notifications
        );

    } catch (err) {

        console.warn(
            '[SLT Access Sheets] saveAccess failed:',
            err
        );

    }

}


/* ================= ERROR HANDLING ================= */

function showPushError(message) {

    const notifyBtn = document.getElementById('notifyBtn');

    if (!notifyBtn) return;

    let error = document.getElementById('pushError');

    if (!error) {

        error = document.createElement('p');

        error.id = 'pushError';

        error.setAttribute('role', 'alert');

        error.setAttribute('aria-live', 'polite');

        error.style.color = '#b00020';

        error.style.fontSize = '13px';

        error.style.marginTop = '12px';

        error.style.textAlign = 'center';

        notifyBtn.parentNode.insertBefore(
            error,
            notifyBtn.nextSibling
        );

    }

    error.textContent = message;

    error.classList.remove('d-none');

}


function clearPushError() {

    const error = document.getElementById('pushError');

    if (error) {

        error.textContent = '';

        error.classList.add('d-none');

    }

}


/* ================= HELPERS ================= */

function showSheet(id) {

    const sheet = document.getElementById(id);

    if (!sheet) return;

    sheet.setAttribute('aria-hidden', 'false');

    requestAnimationFrame(() => {
        sheet.classList.add('open');
    });

}


function closeAllSheets() {

    document.querySelectorAll('.access-sheet').forEach(sheet => {

        sheet.classList.remove('open', 'behind');

        sheet.setAttribute('aria-hidden', 'true');

    });

    document.body.classList.remove('access-open');

    setAccessLoading(false);

}


function setAccessLoading(isLoading) {

    ['notifyBtn', 'notifySkipBtn', 'notifyClose'].forEach(id => {

        const button = document.getElementById(id);

        if (button) {
            button.disabled = isLoading;
        }

    });

    const spinner = document.querySelector(
        '#notifyBtn .spinner-border'
    );

    if (spinner) {
        spinner.classList.toggle('d-none', !isLoading);
    }

}


