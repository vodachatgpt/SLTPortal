IF OBJECT_ID('dbo.GuestMessageDeliveries','U') IS NULL
BEGIN
 CREATE TABLE dbo.GuestMessageDeliveries (
    Id bigint IDENTITY(1,1) PRIMARY KEY,
    GuestId bigint NOT NULL,
    Channel nvarchar(10) NOT NULL,
    TemplateKey nvarchar(100) NOT NULL,
    Status nvarchar(20) NOT NULL,
    AttemptedAt datetime2(3) NOT NULL,
    CompletedAt datetime2(3) NULL,
    ErrorMessage nvarchar(1000) NULL,
    CreatedBy nvarchar(250) NOT NULL,
    CONSTRAINT FK_GuestMessageDeliveries_Guests FOREIGN KEY(GuestId) REFERENCES dbo.Guests(Id),
    CONSTRAINT CK_GuestMessageDeliveries_Channel CHECK(Channel IN ('Email','Sms')),
    CONSTRAINT CK_GuestMessageDeliveries_Status CHECK(Status IN ('Pending','Accepted','Failed'))
 );
 CREATE INDEX IX_GuestMessageDeliveries_GuestId ON dbo.GuestMessageDeliveries(GuestId, AttemptedAt DESC);
END;

