        </section>

    `);


    /* Install events */

    document
        .getElementById('installBtn')
        .addEventListener('click', onInstallTap);

    document
        .getElementById('installClose')
        .addEventListener('click', afterInstallSheet);


    /* Notification events */

    document
        .getElementById('notifyBtn')
        .addEventListener('click', onNotifyAllowTap);

    document
        .getElementById('notifySkipBtn')
        .addEventListener('click', () => finishAccess('skipped'));

    document
        .getElementById('notifyClose')
        .addEventListener('click', () => finishAccess('skipped'));

}

/* =========================================================
   1. INSTALL FLOW
   ========================================================= */

function openInstallSheet() {

    document.body.classList.add('access-open');

    showSheet('installSheet');

}


async function onInstallTap() {

    if (accessFinishing || accessInstallBusy) return;

    if (accessManualShown) {

        afterInstallSheet();

        return;
    }

    if (accessInstallPrompt) {

        accessInstallBusy = true;

        const prompt = accessInstallPrompt;

        accessInstallPrompt = null;

        try {

            await prompt.prompt();

            const choice = await prompt.userChoice;

            if (choice && choice.outcome === 'accepted') {
                accessInstalled = true;
            }

        } catch (err) {

            console.warn('[SLT Install]', err);

        } finally {

            accessInstallBusy = false;

        }

        afterInstallSheet();

        return;
    }

    showManualInstallSteps();

}


function showManualInstallSteps() {

    const isIphone = isIphoneOrIpad();

    const note = document.getElementById(
        isIphone ? 'iphoneNote' : 'androidNote'
    );

    if (note) {

        note.classList.remove('d-none');

        note.classList.remove('flash');

        void note.offsetWidth;

        note.classList.add('flash');

    }

    document.getElementById('installBtn').textContent = 'Done';

    accessManualShown = true;

}


/* =========================================================
   2. NOTIFICATION INITIALIZATION
   ========================================================= */

function afterInstallSheet() {

    accessInstalled = isInstalledApp();

    openNotifySheet();

}


/*
    IMPORTANT:

    This follows the same support and permission checks
    implemented in the working AllowAccess.js.

    Permission granted does NOT automatically mean that
    the guest has an active push subscription.
*/

function isPartnerPushSupported() {

    try {

        return (
            'Notification' in window &&
            !!window.PartnerGuestPush &&
            typeof PartnerGuestPush.supported === 'function' &&
            PartnerGuestPush.supported()
        );

    } catch (err) {

        console.warn('[SLT Push] Support check failed:', err);

        return false;

    }

}


async function openNotifySheet() {

    if (accessFinishing) return;

    /*
       Unsupported browser or unavailable push integration.
    */

    if (!isPartnerPushSupported()) {

        await finishAccess(currentNotifyPermission());

        return;
    }


    /*
       Permission was previously denied.
       Do not repeatedly display a permission request.
    */

    if (Notification.permission === 'denied') {

        await finishAccess('denied');

        return;
    }


    /*
       Display the notification sheet.
    */

    document.body.classList.add('access-open');

    const install = document.getElementById('installSheet');

    if (install && install.classList.contains('open')) {

        install.classList.add('behind');

    }

    showSheet('notifySheet');


    /*
       IMPORTANT:

       If permission is already granted, synchronize the
       existing browser subscription with the SLT backend.

       Do not assume permission = successful subscription.
    */

    if (Notification.permission === 'granted') {

        await synchronizeExistingSubscription();

    }

}


/* =========================================================
   3. SYNCHRONIZE EXISTING PUSH SUBSCRIPTION
   ========================================================= */

async function synchronizeExistingSubscription() {

    if (accessSyncing || accessFinishing) return;

    if (!isPartnerPushSupported()) return;

    if (Notification.permission !== 'granted') return;

    /*
       In test mode, keep the sheet available even when
       synchronization succeeds, allowing the user to
       test the notification button again.
    */

    accessSyncing = true;

    try {

        const result = await PartnerGuestPush.synchronize();

        console.log('[SLT Access Sheets] Push synchronization:', result);

        if (result && result.subscribed) {

            if (!CONFIG.testMode) {

                await finishAccess('granted');

            }

        } else {

            showPushError(
                'Notifications are allowed, but your device is not subscribed yet. Tap Allow Notification to complete the setup.'
            );

        }

    } catch (err) {

        console.warn(
            '[SLT Access Sheets] Push synchronization failed:',
            err
        );

        showPushError(
            'Your notification subscription could not be synchronized. Please tap Allow Notification to retry.'
        );

    } finally {

        accessSyncing = false;

    }

}


/* =========================================================
   4. ENABLE NOTIFICATIONS
   ========================================================= */

/*
   This is intentionally the same integration used by
   AllowAccess.js.

   PartnerGuestPush.enable() handles:
     - Browser notification permission
     - Service worker integration
     - Push subscription creation
     - Backend subscription synchronization

   We only report success when result.subscribed = true.
*/

async function onNotifyAllowTap() {

    if (accessFinishing || accessSyncing) return;

    setAccessLoading(true);

    clearPushError();

    try {

        /*
           Verify browser and SDK support.
        */

        if (!isPartnerPushSupported()) {

            throw new Error(
                'Push notifications are not supported by this browser.'
            );

        }


        /*
           iPhone requires the installed Home Screen app.
        */

        if (isIphoneOrIpad() && !isInstalledApp()) {

            throw new Error(
                'Install and open the Home Screen app on iPhone first.'
            );

        }


        /*
           Use the SAME enable method as AllowAccess.js.
        */

        const result = await PartnerGuestPush.enable();

        console.log('[SLT Access Sheets] Push enable result:', result);


        /*
           Never treat permission alone as successful.
        */

        if (!result || !result.subscribed) {

            /*
               If the user denied browser permission,
               save the actual permission status.
            */

            if (currentNotifyPermission() === 'denied') {

                await finishAccess('denied');

                return;

            }

            throw new Error(
                'Subscription was not confirmed by SLTAPI.'
            );

        }


        /*
           Subscription successfully confirmed.
        */

        await finishAccess('granted');

    } catch (err) {

        console.error('[SLT Access Sheets] Push enable failed:', err);

        showPushError(
            'Notifications were not enabled: ' +
            (err && err.message ? err.message : 'Unknown error') +
            '. Please retry or select Not now.'
        );

    } finally {

        if (!accessFinishing) {

            setAccessLoading(false);

        }

    }

}


/* =========================================================
   5. NOTIFICATION PERMISSION
   ========================================================= */

function currentNotifyPermission() {

    return 'Notification' in window
        ? Notification.permission
        : 'unsupported';

}


/* =========================================================
   6. FINISH ACCESS
   ========================================================= */

/*
   Saves the guest's preferences using the existing API.

   installedApp  -> whether the application is installed
   notifications -> granted / denied / skipped / unsupported

   Prevents duplicate API calls from multiple clicks.
*/

async function finishAccess(notifications) {

    if (accessFinishing) return;

    accessFinishing = true;

    setAccessLoading(true);

    try {

        await saveAccess(
            accessInstalled,
            notifications
        );

    } catch (err) {

        console.warn('[SLT Access Sheets] saveAccess failed:', err);

    }

    /*
       Preserve the existing one-time access behavior.
    */

    writeStorage(STORAGE.accessDone, 'yes');

    closeAllSheets();

}


/* =========================================================
   7. ERROR HANDLING
   ========================================================= */

function showPushError(message) {

    const notifyBtn = document.getElementById('notifyBtn');

    if (!notifyBtn) return;

    let error = document.getElementById('pushError');

    if (!error) {

        error = document.createElement('p');

        error.id = 'pushError';

        error.setAttribute('role', 'alert');

        error.setAttribute('aria-live', 'polite');

        error.style.color = '#b00020';

        error.style.fontSize = '13px';

        error.style.marginTop = '12px';

        error.style.textAlign = 'center';

        notifyBtn.parentNode.insertBefore(
            error,
            notifyBtn.nextSibling
        );

    }

    error.textContent = message;

    error.classList.remove('d-none');

}


function clearPushError() {

    const error = document.getElementById('pushError');

    if (error) {

        error.textContent = '';

        error.classList.add('d-none');

    }

}


/* =========================================================
   8. SHEET HELPERS
   ========================================================= */

function showSheet(id) {

    const sheet = document.getElementById(id);

    if (!sheet) return;

    sheet.setAttribute('aria-hidden', 'false');

    requestAnimationFrame(() => {

        sheet.classList.add('open');

    });

}


function closeAllSheets() {

    document.querySelectorAll('.access-sheet').forEach(sheet => {

        sheet.classList.remove('open', 'behind');

        sheet.setAttribute('aria-hidden', 'true');

    });

    document.body.classList.remove('access-open');

    setAccessLoading(false);

}


/* =========================================================
   9. LOADING STATE
   ========================================================= */

function setAccessLoading(isLoading) {

    const buttonIds = [
        'notifyBtn',
        'notifySkipBtn',
        'notifyClose'
    ];

    buttonIds.forEach(id => {

        const button = document.getElementById(id);

        if (button) {

            button.disabled = isLoading;

        }

    });

    const spinner = document.querySelector(
        '#notifyBtn .spinner-border'
    );

    if (spinner) {

        spinner.classList.toggle('d-none', !isLoading);

    }

}


